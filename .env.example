# Sohojac local Worker environment (.env, not .env.local).
# Copy to .env; this example is safe to commit, the actual .env is gitignored.
# Cloudflare Vite loads .env for local Worker bindings.
NEXT_PUBLIC_SITE_URL=https://sohojac.com

# Registration spam protection. Create a Cloudflare Turnstile widget for
# localhost (development) and sohojac.com (production).
# Site key is public; secret must never be committed.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Better Auth staff CRM: never commit the actual local .env.
# Use a random >=32-character secret. The CI deployment has a separate
# BETTER_AUTH_SECRET secret and BETTER_AUTH_URL variable.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173
# No public signup, student/guardian login or staff bootstrap on the web.
